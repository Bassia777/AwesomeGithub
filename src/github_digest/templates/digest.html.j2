<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GitHub Trending 全球 Top 5</title>
</head>
<body style="margin:0;padding:0;background:#f5f7fb;color:#1f2937;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#f5f7fb;">
    <tr><td align="center" style="padding:24px 12px;">
      <table role="presentation" width="640" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:640px;background:#ffffff;border-radius:12px;overflow:hidden;">
        <tr><td style="padding:28px 28px 20px;background:#111827;color:#ffffff;">
          <div style="font-size:22px;font-weight:700;line-height:1.4;">GitHub Trending 全球 Top 5</div>
          <div style="margin-top:6px;font-size:14px;color:#d1d5db;">{{ report.report_date }} · 全球热门项目</div>
        </td></tr>
{% for project in projects %}
        <tr><td data-project-card="true" style="padding:20px 28px;border-bottom:1px solid #e5e7eb;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;">
            <tr>
              <td valign="top" style="width:36px;font-size:20px;font-weight:700;color:#2563eb;">{{ project.repository.rank }}</td>
              <td valign="top">
                <a href="{{ project.url }}" style="color:#1d4ed8;font-size:18px;font-weight:700;line-height:1.4;text-decoration:none;">{{ project.repository.full_name }}</a>
                <div style="margin-top:7px;font-size:13px;line-height:1.5;color:#4b5563;">{{ project.streak_label }} · {{ project.repository.language }} · {{ '{:,}'.format(project.repository.stars) }} Stars</div>
                <div style="margin-top:10px;font-size:15px;line-height:1.7;color:#374151;">{{ project.repository.summary_zh }}</div>
                <div style="margin-top:12px;"><a href="{{ project.url }}" style="font-size:14px;color:#2563eb;text-decoration:underline;">查看项目 ↗</a></div>
              </td>
            </tr>
          </table>
        </td></tr>
{% endfor %}
        <tr><td style="padding:20px 28px;background:#f9fafb;font-size:12px;line-height:1.6;color:#6b7280;">
          本邮件由 GitHub Actions 自动生成；项目摘要可能来自 Gemini 或仓库公开描述。
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
