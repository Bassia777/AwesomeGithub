<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GitHub Trending 全球 Top 5</title>
</head>
<body style="margin:0;padding:0;background:#f5f7fb;color:#1f2937;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#f5f7fb;">
    <tr><td align="center" style="padding:24px 12px;">
      <table role="presentation" width="640" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:640px;">
        <tr><td style="padding:28px 28px 20px;background:#111827;color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;border-radius:12px 12px 0 0;">
          <h1 style="margin:0;font-size:22px;font-weight:700;line-height:1.4;">GitHub Trending 全球 Top 5</h1>
          <div style="margin-top:6px;font-size:14px;color:#d1d5db;">{{ report_date }} · 全球热门项目</div>
        </td></tr>
{% for project in projects %}
        <tr><td style="padding:0;padding-bottom:12px;">
          <table role="presentation" data-project-card="true" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;">
            <tr>
              <td valign="top" style="padding:20px 8px 20px 20px;width:36px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;font-size:20px;font-weight:700;color:#2563eb;">{{ project.rank }}</td>
              <td valign="top" style="padding:20px 20px 20px 8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;">
<img src="{{ project.image_url }}" alt="{{ project.full_name }} 项目配图" width="100%" style="display:block;width:100%;max-width:560px;height:180px;object-fit:cover;object-position:center;margin:0 0 14px;border-radius:8px;">
{% if project.url %}
                <h2 style="margin:0;"><a href="{{ project.url }}" style="color:#1d4ed8;font-size:18px;font-weight:700;line-height:1.4;text-decoration:none;">{{ project.full_name }}</a></h2>
{% else %}
                <h2 style="margin:0;color:#1f2937;font-size:18px;font-weight:700;line-height:1.4;">{{ project.full_name }}</h2>
{% endif %}
                <div style="margin-top:7px;font-size:13px;line-height:1.5;color:#4b5563;">{{ project.streak_label }} · {{ project.language }} · {{ '{:,}'.format(project.stars) }} Stars · 今日新增 {{ '{:,}'.format(project.stars_today) }} Stars</div>
                <div style="margin-top:12px;font-size:12px;font-weight:700;color:#111827;">详细介绍</div>
                <div style="margin-top:4px;font-size:15px;line-height:1.7;color:#374151;">{{ project.summary }}</div>
                <div style="margin-top:12px;padding:10px 12px;background:#eff6ff;border-left:3px solid #2563eb;font-size:14px;line-height:1.6;color:#1e3a8a;"><strong>一句话总结：</strong>{{ project.simple_summary }}</div>
{% if project.url %}
                <div style="margin-top:12px;"><a href="{{ project.url }}" style="font-size:14px;color:#2563eb;text-decoration:underline;">查看项目 ↗</a></div>
{% endif %}
              </td>
            </tr>
          </table>
        </td></tr>
{% endfor %}
        <tr><td style="padding:20px 28px;background:#f9fafb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;font-size:12px;line-height:1.6;color:#6b7280;border-radius:0 0 12px 12px;">
          本邮件由 GitHub Actions 自动生成；项目摘要可能来自 Gemini 或仓库公开描述。
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
